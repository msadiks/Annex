{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Annex",
  "mainBinaryName": "annex",
  "version": "1.1.0",
  "identifier": "com.msadiks.annex",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "category": "Utility",
    "shortDescription": "Use a Windows PC's monitors as extra Mac displays",
    "copyright": "Annex contributors, MIT OR Apache-2.0",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.png"],
    "macOS": {
      "minimumSystemVersion": "13.0",
      "dmg": {
        "background": "dmg/background.tiff",
        "windowSize": { "width": 660, "height": 432 },
        "appPosition": { "x": 180, "y": 190 },
        "applicationFolderPosition": { "x": 480, "y": 190 }
      }
    }
  }
}
