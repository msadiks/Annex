#include <winver.h>
1 ICON "annex.ico"
1 24 "annex.manifest"
VS_VERSION_INFO VERSIONINFO
FILEVERSION 1,1,0,0
PRODUCTVERSION 1,1,0,0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Annex"
      VALUE "FileDescription", "Annex"
      VALUE "FileVersion", "1.1.0"
      VALUE "ProductName", "Annex"
      VALUE "ProductVersion", "1.1.0"
      VALUE "OriginalFilename", "annex.exe"
      VALUE "LegalCopyright", "MIT OR Apache-2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
